{
  "name": "@fission-ai/openspec-website",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for OpenSpec, built with Fumadocs and deployable to Cloudflare Pages.",
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "build": "pnpm run sync:docs && fumadocs-mdx && next build",
    "dev": "pnpm run sync:docs && next dev",
    "start": "serve out",
    "types:check": "pnpm run sync:docs && fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "^16.17.10",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.10",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.22",
      "sharp": "^0.35.3",
      "brace-expansion@<=5.0.7": ">=5.0.8"
    }
  }
}
